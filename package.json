  "description": "基于 Node.js + Koa 3 + MySQL 的内容社区后端（TypeScript）",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
